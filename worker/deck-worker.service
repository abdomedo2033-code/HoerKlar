[Unit]
Description=HoerKlar ingest worker (Deck over Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deck/Downloads/Dutch_App
Environment=API_BASE=https://hoerklar-proxy.onrender.com
Environment=HK_WORKDIR=/home/deck/Downloads/Dutch_App/_clipcache_ingest
# Set once: systemctl --user edit deck-worker  ->  Environment=HK_WORKER_TOKEN=...
ExecStart=/home/deck/whisperenv/bin/python /home/deck/Downloads/Dutch_App/worker/worker.py
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
